{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Country",
  "type": "object",
  "description": "Country information",
  "x-resource": {
    "name": "countries",
    "singular": "country",
    "description": "Countries with details"
  },
  "properties": {
    "id": {
      "type": "integer",
      "description": "Country ID",
      "x-generator": "random_int",
      "x-generator-params": {
        "min": 1,
        "max": 300
      }
    },
    "name": {
      "type": "string",
      "description": "Country name",
      "x-generator": "country"
    },
    "code": {
      "type": "string",
      "description": "ISO 3166-1 alpha-2 code",
      "x-generator": "country_code"
    },
    "code3": {
      "type": "string",
      "description": "ISO 3166-1 alpha-3 code",
      "x-generator": "country_code3"
    },
    "capital": {
      "type": "string",
      "description": "Capital city",
      "x-generator": "capital"
    },
    "region": {
      "type": "string",
      "description": "Geographic region",
      "x-generator": "region"
    },
    "subregion": {
      "type": "string",
      "description": "Geographic subregion",
      "x-generator": "subregion"
    },
    "population": {
      "type": "integer",
      "description": "Population",
      "x-generator": "population"
    },
    "area": {
      "type": "number",
      "description": "Area in km²",
      "x-generator": "area"
    },
    "languages": {
      "type": "array",
      "description": "Official languages",
      "x-generator": "languages_array"
    },
    "currency": {
      "type": "string",
      "description": "Currency code",
      "x-generator": "currency_code"
    },
    "calling_code": {
      "type": "string",
      "description": "Phone calling code",
      "x-generator": "calling_code"
    },
    "timezone": {
      "type": "string",
      "description": "Primary timezone",
      "x-generator": "timezone"
    },
    "flag": {
      "type": "string",
      "format": "uri",
      "description": "Flag image URL",
      "x-generator": "flag_url"
    }
  },
  "required": ["id", "name", "code"]
}

