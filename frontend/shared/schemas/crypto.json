{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Crypto",
  "type": "object",
  "x-resource": {"name": "crypto", "singular": "cryptocurrency"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "symbol": {"type": "string", "x-generator": "crypto_symbol"},
    "name": {"type": "string", "x-generator": "crypto_name"},
    "price": {"type": "number", "x-generator": "crypto_price"},
    "change_24h": {"type": "number", "x-generator": "stock_change_percent"},
    "volume_24h": {"type": "number", "x-generator": "stock_volume"},
    "market_cap": {"type": "number", "x-generator": "market_cap"},
    "circulating_supply": {"type": "number", "x-generator": "crypto_supply"},
    "total_supply": {"type": "number", "x-generator": "crypto_supply"},
    "high_24h": {"type": "number", "x-generator": "crypto_price"},
    "low_24h": {"type": "number", "x-generator": "crypto_price"},
    "ath": {"type": "number", "description": "All-time high", "x-generator": "crypto_price"},
    "ath_date": {"type": "string", "format": "date", "x-generator": "past_date"},
    "rank": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 100}},
    "timestamp": {"type": "string", "format": "date-time", "x-generator": "date_time"}
  }
}

