{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task",
  "type": "object",
  "x-resource": {"name": "tasks", "singular": "task"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "project_id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 1000}},
    "title": {"type": "string", "x-generator": "sentence"},
    "description": {"type": "string", "x-generator": "paragraph"},
    "assignee": {"type": "string", "x-generator": "name"},
    "assignee_id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 1000}},
    "status": {"type": "string", "x-generator": "task_status"},
    "priority": {"type": "string", "x-generator": "priority"},
    "due_date": {"type": "string", "format": "date", "x-generator": "future_date"},
    "estimated_hours": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 40}},
    "actual_hours": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 0, "max": 50}},
    "created_at": {"type": "string", "format": "date-time", "x-generator": "past_date"},
    "completed_at": {"type": "string", "format": "date-time", "x-generator": "past_date"}
  }
}

