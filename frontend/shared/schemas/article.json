{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Article",
  "type": "object",
  "x-resource": {"name": "articles", "singular": "article"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "title": {"type": "string", "x-generator": "sentence"},
    "slug": {"type": "string", "x-generator": "slug"},
    "author": {"type": "string", "x-generator": "name"},
    "author_id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 1000}},
    "content": {"type": "string", "x-generator": "paragraph"},
    "excerpt": {"type": "string", "x-generator": "sentence"},
    "category": {"type": "string", "x-generator": "article_category"},
    "tags": {"type": "array", "x-generator": "tags"},
    "status": {"type": "string", "x-generator": "status"},
    "views": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 0, "max": 100000}},
    "likes": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 0, "max": 5000}},
    "comments_count": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 0, "max": 500}},
    "featured_image": {"type": "string", "format": "uri", "x-generator": "image_url"},
    "published_at": {"type": "string", "format": "date-time", "x-generator": "past_date"},
    "updated_at": {"type": "string", "format": "date-time", "x-generator": "past_date"}
  }
}

