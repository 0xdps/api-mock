{
  "name": "@api-mockly/frontend",
  "version": "1.0.0",
  "description": "Mockly frontend - Modern UI for 100+ mock API resources across 14 categories",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @api-mockly/shared generate-types",
    "prebuild": "pnpm --filter @api-mockly/shared generate-types",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "type-check": "tsc --noEmit",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@api-mockly/shared": "workspace:*",
    "@pingpong-js/fetch": "^1.0.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next": "^16.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.19.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.0.0"
  }
}
