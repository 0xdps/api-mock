# ── Backend API URL ───────────────────────────────────────────────────────────
# URL of the Go backend. Only needed server-side or to override auto-detection.
# In local dev the frontend auto-uses http://localhost:8080, so you can omit this.
NEXT_PUBLIC_API_URL=http://localhost:8080

# ── Site URL ──────────────────────────────────────────────────────────────────
# Public URL of this frontend. Used for absolute links and OAuth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── nube-auth ─────────────────────────────────────────────────────────────────
# Gateway URL — use the default unless you are self-hosting nube-auth.
NEXT_PUBLIC_NUBE_GATEWAY_URL=https://api.nubeauth.com

# App ID from your nube-auth application dashboard.
# Required for the Google OAuth login flow.
NEXT_PUBLIC_NUBE_APP_ID=your_nube_app_id_here
