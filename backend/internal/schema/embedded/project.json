{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project",
  "type": "object",
  "x-resource": {"name": "projects", "singular": "project"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "name": {"type": "string", "x-generator": "sentence"},
    "description": {"type": "string", "x-generator": "paragraph"},
    "owner": {"type": "string", "x-generator": "name"},
    "owner_id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 1000}},
    "status": {"type": "string", "x-generator": "project_status"},
    "priority": {"type": "string", "x-generator": "priority"},
    "budget": {"type": "number", "x-generator": "price"},
    "currency": {"type": "string", "x-generator": "currency"},
    "start_date": {"type": "string", "format": "date", "x-generator": "past_date"},
    "end_date": {"type": "string", "format": "date", "x-generator": "future_date"},
    "completion": {"type": "integer", "description": "Percentage", "x-generator": "percentage"},
    "team_size": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 50}},
    "created_at": {"type": "string", "format": "date-time", "x-generator": "past_date"}
  }
}

