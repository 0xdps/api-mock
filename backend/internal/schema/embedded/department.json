{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Department",
  "type": "object",
  "x-resource": {"name": "departments", "singular": "department", "group": "business"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 100}},
    "name": {"type": "string", "x-generator": "department"},
    "code": {"type": "string", "x-generator": "word"},
    "manager_id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 100}},
    "employee_count": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 5, "max": 100}},
    "budget": {"type": "number", "x-generator": "random_int", "x-generator-params": {"min": 100000, "max": 5000000}},
    "location": {"type": "string", "x-generator": "city"},
    "description": {"type": "string", "x-generator": "paragraph"},
    "established": {"type": "string", "format": "date", "x-generator": "past_date"}
  }
}

