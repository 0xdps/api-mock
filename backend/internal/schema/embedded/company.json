{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Company",
  "type": "object",
  "description": "Company information",
  "x-resource": {
    "name": "companies",
    "singular": "company",
    "description": "Business companies"
  },
  "properties": {
    "id": {
      "type": "integer",
      "x-generator": "random_int",
      "x-generator-params": {"min": 1, "max": 10000}
    },
    "name": {
      "type": "string",
      "x-generator": "company"
    },
    "slogan": {
      "type": "string",
      "x-generator": "catch_phrase"
    },
    "description": {
      "type": "string",
      "x-generator": "paragraph"
    },
    "industry": {
      "type": "string",
      "x-generator": "industry"
    },
    "size": {
      "type": "string",
      "x-generator": "company_size"
    },
    "founded_year": {
      "type": "integer",
      "x-generator": "founded_year"
    },
    "headquarters": {
      "type": "string",
      "x-generator": "city"
    },
    "country": {
      "type": "string",
      "x-generator": "country"
    },
    "website": {
      "type": "string",
      "format": "uri",
      "x-generator": "url"
    },
    "email": {
      "type": "string",
      "format": "email",
      "x-generator": "email"
    },
    "phone": {
      "type": "string",
      "x-generator": "phone"
    },
    "revenue": {
      "type": "number",
      "x-generator": "revenue"
    },
    "employees": {
      "type": "integer",
      "x-generator": "employees"
    },
    "logo": {
      "type": "string",
      "format": "uri",
      "x-generator": "image_url"
    }
  }
}

