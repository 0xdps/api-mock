{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Song",
  "type": "object",
  "x-resource": {"name": "songs", "singular": "song", "group": "media"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "title": {"type": "string", "x-generator": "sentence"},
    "artist": {"type": "string", "x-generator": "name"},
    "album": {"type": "string", "x-generator": "sentence"},
    "duration": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 120, "max": 600}},
    "genre": {"type": "string", "x-generator": "word"},
    "url": {"type": "string", "format": "uri", "x-generator": "url"},
    "plays": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 0, "max": 1000000}},
    "released_at": {"type": "string", "format": "date", "x-generator": "past_date"}
  }
}
