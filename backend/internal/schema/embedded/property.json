{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Property",
  "type": "object",
  "x-resource": {"name": "properties", "singular": "property"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "title": {"type": "string", "x-generator": "property_title"},
    "description": {"type": "string", "x-generator": "paragraph"},
    "type": {"type": "string", "x-generator": "property_type"},
    "status": {"type": "string", "x-generator": "property_status"},
    "address": {"type": "string", "x-generator": "address"},
    "city": {"type": "string", "x-generator": "city"},
    "state": {"type": "string", "x-generator": "state"},
    "country": {"type": "string", "x-generator": "country"},
    "zip_code": {"type": "string", "x-generator": "zip"},
    "latitude": {"type": "number", "x-generator": "latitude"},
    "longitude": {"type": "number", "x-generator": "longitude"},
    "price": {"type": "number", "x-generator": "property_price"},
    "currency": {"type": "string", "x-generator": "currency"},
    "bedrooms": {"type": "integer", "x-generator": "bedrooms"},
    "bathrooms": {"type": "integer", "x-generator": "bathrooms"},
    "area": {"type": "number", "description": "Square meters", "x-generator": "property_area"},
    "year_built": {"type": "integer", "x-generator": "year_built"},
    "features": {"type": "array", "x-generator": "property_features"},
    "image": {"type": "string", "format": "uri", "x-generator": "image_url"}
  }
}

