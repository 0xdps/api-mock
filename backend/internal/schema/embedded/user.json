{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "User",
  "description": "A user resource",
  "x-resource": {
    "name": "users",
    "singular": "user",
    "description": "User accounts with profile information"
  },
  "properties": {
    "id": {
      "type": "integer",
      "description": "Unique identifier",
      "x-generator": "random_int",
      "x-generator-params": {
        "min": 1,
        "max": 10000
      }
    },
    "username": {
      "type": "string",
      "description": "Username",
      "x-generator": "username"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address",
      "x-generator": "email"
    },
    "first_name": {
      "type": "string",
      "x-generator": "first_name"
    },
    "last_name": {
      "type": "string",
      "x-generator": "last_name"
    },
    "avatar": {
      "type": "string",
      "format": "uri",
      "x-generator": "url"
    },
    "gender": {
      "type": "string",
      "enum": ["male", "female"],
      "x-generator": "gender"
    },
    "phone": {
      "type": "string",
      "x-generator": "phone"
    },
    "address": {
      "type": "string",
      "x-generator": "address"
    },
    "city": {
      "type": "string",
      "x-generator": "city"
    },
    "country": {
      "type": "string",
      "x-generator": "country"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "x-generator": "past_date"
    }
  },
  "required": ["id", "username", "email"]
}