{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Inventory",
  "type": "object",
  "x-resource": {"name": "inventory", "singular": "inventory_item", "group": "commerce"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "product_id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 5000}},
    "sku": {"type": "string", "x-generator": "uuid"},
    "quantity": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 0, "max": 1000}},
    "reserved": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 0, "max": 100}},
    "location": {"type": "string", "x-generator": "city"},
    "last_updated": {"type": "string", "format": "date-time", "x-generator": "past_date"}
  }
}
