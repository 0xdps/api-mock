{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Promotion",
  "type": "object",
  "x-resource": {"name": "promotions", "singular": "promotion", "group": "commerce"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 1000}},
    "title": {"type": "string", "x-generator": "sentence"},
    "description": {"type": "string", "x-generator": "paragraph"},
    "discount_percentage": {"type": "number", "x-generator": "float", "x-generator-params": {"min": 5, "max": 50}},
    "start_date": {"type": "string", "format": "date", "x-generator": "past_date"},
    "end_date": {"type": "string", "format": "date", "x-generator": "future_date"},
    "active": {"type": "boolean", "x-generator": "boolean"}
  }
}
