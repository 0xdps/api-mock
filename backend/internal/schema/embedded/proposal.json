{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Proposal",
  "type": "object",
  "x-resource": {"name": "proposals", "singular": "proposal", "group": "business"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "title": {"type": "string", "x-generator": "sentence"},
    "client_id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 1000}},
    "description": {"type": "string", "x-generator": "paragraph"},
    "value": {"type": "number", "x-generator": "price"},
    "currency": {"type": "string", "x-generator": "currency"},
    "status": {"type": "string", "x-generator": "status"},
    "submitted_date": {"type": "string", "format": "date-time", "x-generator": "past_date"},
    "valid_until": {"type": "string", "format": "date", "x-generator": "future_date"},
    "created_by": {"type": "string", "x-generator": "name"}
  }
}

