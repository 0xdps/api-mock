{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shipping",
  "type": "object",
  "x-resource": {"name": "shippings", "singular": "shipping", "group": "commerce"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "order_id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "tracking_number": {"type": "string", "x-generator": "uuid"},
    "carrier": {"type": "string", "x-generator": "company"},
    "status": {"type": "string", "x-generator": "status"},
    "shipped_date": {"type": "string", "format": "date", "x-generator": "past_date"},
    "estimated_delivery": {"type": "string", "format": "date", "x-generator": "future_date"},
    "address": {"type": "string", "x-generator": "address"}
  }
}
