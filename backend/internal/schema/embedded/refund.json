{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Refund",
  "type": "object",
  "x-resource": {"name": "refunds", "singular": "refund", "group": "commerce"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "order_id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "amount": {"type": "number", "x-generator": "price"},
    "currency": {"type": "string", "x-generator": "currency"},
    "reason": {"type": "string", "x-generator": "sentence"},
    "status": {"type": "string", "x-generator": "status"},
    "processed_date": {"type": "string", "format": "date-time", "x-generator": "past_date"}
  }
}
