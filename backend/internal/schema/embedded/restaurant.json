{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Restaurant",
  "type": "object",
  "x-resource": {"name": "restaurants", "singular": "restaurant"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "name": {"type": "string", "x-generator": "restaurant_name"},
    "description": {"type": "string", "x-generator": "paragraph"},
    "cuisine": {"type": "string", "x-generator": "cuisine"},
    "address": {"type": "string", "x-generator": "address"},
    "city": {"type": "string", "x-generator": "city"},
    "country": {"type": "string", "x-generator": "country"},
    "latitude": {"type": "number", "x-generator": "latitude"},
    "longitude": {"type": "number", "x-generator": "longitude"},
    "phone": {"type": "string", "x-generator": "phone"},
    "email": {"type": "string", "format": "email", "x-generator": "email"},
    "website": {"type": "string", "format": "uri", "x-generator": "url"},
    "rating": {"type": "number", "x-generator": "rating"},
    "price_range": {"type": "string", "x-generator": "price_range"},
    "opening_hours": {"type": "string", "x-generator": "opening_hours"},
    "delivery": {"type": "boolean", "x-generator": "boolean"},
    "image": {"type": "string", "format": "uri", "x-generator": "image_url"}
  }
}

