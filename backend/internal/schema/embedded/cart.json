{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cart",
  "type": "object",
  "x-resource": {"name": "carts", "singular": "cart", "group": "commerce"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "user_id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 1000}},
    "items": {"type": "array", "items": {"type": "string"}, "x-generator": "tags"},
    "total": {"type": "number", "x-generator": "price"},
    "currency": {"type": "string", "x-generator": "currency"},
    "status": {"type": "string", "x-generator": "status"},
    "created_at": {"type": "string", "format": "date-time", "x-generator": "past_date"},
    "updated_at": {"type": "string", "format": "date-time", "x-generator": "past_date"}
  }
}
