{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stream",
  "type": "object",
  "x-resource": {"name": "streams", "singular": "stream", "group": "media"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "title": {"type": "string", "x-generator": "sentence"},
    "streamer": {"type": "string", "x-generator": "name"},
    "url": {"type": "string", "format": "uri", "x-generator": "url"},
    "viewers": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 0, "max": 100000}},
    "status": {"type": "string", "x-generator": "status"},
    "started_at": {"type": "string", "format": "date-time", "x-generator": "past_date"}
  }
}
