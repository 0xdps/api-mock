# Server Configuration
PORT=8080

# Redis Configuration (optional - falls back to local cache if not configured)
# Format: redis://:<password>@<host>:<port>/<db>  (plain)
#         rediss://:<password>@<host>:<port>/<db> (TLS — e.g. Upstash)
# On Railway: REDIS_URL is auto-injected when you add a Redis plugin.
# On local: use redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Cache Configuration
# CACHE_MODE: off | local | remote | all
#   off    - no caching
#   local  - in-memory only
#   remote - Redis only
#   all    - in-memory + Redis (recommended for production)
CACHE_MODE=all
CACHE_ITEMS_PER_RESOURCE=100
CACHE_SEED=42
MAX_ITEMS_PER_RESOURCE=1000

# Umami Analytics (optional - backend-side event tracking)
# UMAMI_BACKEND_ENABLED: set to true to enable backend analytics
# UMAMI_COLLECT_URL: the /api/send endpoint of your Umami instance
# UMAMI_WEBSITE_ID: website ID from your Umami dashboard
# UMAMI_HOSTNAME: hostname to report events under (e.g. api.yourdomain.com)
UMAMI_BACKEND_ENABLED=false
UMAMI_COLLECT_URL=
UMAMI_WEBSITE_ID=
UMAMI_HOSTNAME=

# MesaHub — SQLite over HTTP (required for user accounts, templates, API keys)
# Format: mh://shs_<apikey>@<host>/<dbname>
# Leave blank to run in stateless mode (no auth, built-in schemas only).
MESAHUB_URL=mh://shs_yourapikey@db.mesahub.dev/mockly

# nube-auth — validates session tokens sent by the frontend
# Leave as default unless you are self-hosting nube-auth.
NUBE_GATEWAY_URL=https://api.nubeauth.com

# Platform Override (optional)
# Manually set the platform name. Auto-detected if not set.
# Values: railway.com | fly.io | render.com | vercel | cloud-run | heroku | local
# PLATFORM=railway.com
