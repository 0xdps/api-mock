# Server Configuration
PORT=8080

# Redis Configuration (optional - falls back to local cache if not configured)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS_ENABLED=false

# Cache Configuration
# Mode: off, local, remote, all
CACHE_MODE=all
CACHE_ITEMS_PER_RESOURCE=100
CACHE_SEED=42
MAX_ITEMS_PER_RESOURCE=1000
