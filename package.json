{
  "name": "api-mockly",
  "version": "1.0.0",
  "description": "Schema-driven mock API service with 100+ resources across 14 categories",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "generate-types": "pnpm --filter @api-mockly/shared generate-types",
    "deploy": "make deploy",
    "deploy:api": "make deploy-api",
    "lint": "turbo lint",
    "type-check": "turbo type-check"
  },
  "keywords": [
    "mock",
    "api",
    "fake-data",
    "json-schema",
    "mockly"
  ],
  "author": "Devendra Pratap Singh",
  "license": "MIT",
  "devDependencies": {
    "turbo": "^2.3.3"
  }
}
