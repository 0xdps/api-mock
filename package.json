{
  "name": "mockly",
  "version": "1.0.0",
  "description": "Schema-driven mock API service",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run api:dev\" \"npm run web:dev\" --names \"API,WEB\" --prefix-colors \"cyan,magenta\"",
    "api:dev": "cd local && go run main.go",
    "web:dev": "cd web && npm run dev",
    "web:install": "cd web && npm install",
    "generate-types": "node scripts/generate-types.js",
    "types:watch": "watch 'npm run generate-types' shared/schemas"
  },
  "keywords": [
    "mock",
    "api",
    "fake-data",
    "json-schema",
    "mockly"
  ],
  "author": "Devendra Pratap Singh",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
