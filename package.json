{
  "name": "mockly",
  "version": "1.0.0",
  "description": "Schema-driven mock API service with 100+ resources across 14 categories",
  "private": true,
  "workspaces": ["frontend", "backend", "shared"],
  "scripts": {
    "predev": "npm run generate-types",
    "dev": "concurrently \"npm run api:dev\" \"npm run web:dev\" --names \"API,WEB\" --prefix-colors \"cyan,magenta\"",
    "api:dev": "cd backend && go run cmd/server/main.go",
    "api:build": "cd backend && go build -o bin/server ./cmd/server",
    "prebuild": "npm run generate-types",
    "build:local": "npm run api:build && cd frontend && npm run build",
    "web:dev": "cd frontend && npm run dev",
    "web:install": "cd frontend && npm install",
    "postinstall": "npm run generate-types",
    "generate-types": "node shared/scripts/generate-types.js",
    "types:watch": "watch 'npm run generate-types' shared/schemas",
    "sync-schemas": "npm run generate-types && find shared/schemas -name '*.json' -type f -exec cp {} backend/internal/schema/embedded/ \\;",
    "prepare": "husky install"
  },
  "keywords": [
    "mock",
    "api",
    "fake-data",
    "json-schema",
    "mockly"
  ],
  "author": "Devendra Pratap Singh",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.0",
    "husky": "^9.1.6"
  }
}
