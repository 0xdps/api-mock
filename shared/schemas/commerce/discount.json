{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Discount",
  "type": "object",
  "x-resource": {"name": "discounts", "singular": "discount", "group": "commerce"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "code": {"type": "string", "x-generator": "uuid"},
    "type": {"type": "string", "x-generator": "word"},
    "value": {"type": "number", "x-generator": "float", "x-generator-params": {"min": 5, "max": 100}},
    "minimum_purchase": {"type": "number", "x-generator": "price"},
    "max_uses": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 10, "max": 1000}},
    "used_count": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 0, "max": 500}},
    "expires_at": {"type": "string", "format": "date", "x-generator": "future_date"}
  }
}
