{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Category",
  "type": "object",
  "x-resource": {"name": "categories", "singular": "category", "group": "commerce"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 1000}},
    "name": {"type": "string", "x-generator": "category"},
    "slug": {"type": "string", "x-generator": "slug"},
    "description": {"type": "string", "x-generator": "sentence"},
    "parent_id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 0, "max": 100}},
    "order": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 100}},
    "icon": {"type": "string", "x-generator": "word"},
    "color": {"type": "string", "x-generator": "color"},
    "items_count": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 0, "max": 1000}},
    "created_at": {"type": "string", "format": "date-time", "x-generator": "past_date"}
  }
}

