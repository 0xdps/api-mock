{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tag",
  "type": "object",
  "x-resource": {"name": "tags", "singular": "tag", "group": "commerce"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 1000}},
    "name": {"type": "string", "x-generator": "word"},
    "slug": {"type": "string", "x-generator": "slug"},
    "description": {"type": "string", "x-generator": "sentence"},
    "color": {"type": "string", "x-generator": "color"},
    "usage_count": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 0, "max": 10000}},
    "created_at": {"type": "string", "format": "date-time", "x-generator": "past_date"}
  }
}

