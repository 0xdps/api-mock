{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Coupon",
  "type": "object",
  "x-resource": {"name": "coupons", "singular": "coupon", "group": "commerce"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "code": {"type": "string", "x-generator": "coupon_code"},
    "description": {"type": "string", "x-generator": "sentence"},
    "discount_type": {"type": "string", "x-generator": "discount_type"},
    "discount_value": {"type": "number", "x-generator": "price"},
    "min_purchase": {"type": "number", "x-generator": "price"},
    "max_discount": {"type": "number", "x-generator": "price"},
    "currency": {"type": "string", "x-generator": "currency"},
    "usage_limit": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 1000}},
    "used_count": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 0, "max": 500}},
    "valid_from": {"type": "string", "format": "date", "x-generator": "past_date"},
    "valid_until": {"type": "string", "format": "date", "x-generator": "future_date"},
    "active": {"type": "boolean", "x-generator": "boolean"}
  }
}

