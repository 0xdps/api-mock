{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Currency",
  "type": "object",
  "description": "Currency information and exchange rates",
  "x-resource": {
    "name": "currencies",
    "singular": "currency",
    "description": "Currency codes and exchange rates",
    "group": "finance"
  },
  "properties": {
    "id": {
      "type": "integer",
      "description": "Currency ID",
      "x-generator": "random_int",
      "x-generator-params": {
        "min": 1,
        "max": 200
      }
    },
    "code": {
      "type": "string",
      "description": "ISO 4217 currency code",
      "x-generator": "currency_code"
    },
    "name": {
      "type": "string",
      "description": "Currency name",
      "x-generator": "currency_name"
    },
    "symbol": {
      "type": "string",
      "description": "Currency symbol",
      "x-generator": "currency_symbol"
    },
    "exchange_rate": {
      "type": "number",
      "description": "Exchange rate to USD",
      "x-generator": "exchange_rate"
    },
    "countries": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Countries using this currency",
      "x-generator": "currency_countries"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last update time",
      "x-generator": "date_time"
    }
  },
  "required": ["id", "code", "name"]
}

