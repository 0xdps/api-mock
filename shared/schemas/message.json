{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Message",
  "type": "object",
  "x-resource": {"name": "messages", "singular": "message"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "conversation_id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 1000}},
    "sender_id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 1000}},
    "sender_name": {"type": "string", "x-generator": "name"},
    "receiver_id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 1000}},
    "receiver_name": {"type": "string", "x-generator": "name"},
    "content": {"type": "string", "x-generator": "sentence"},
    "type": {"type": "string", "x-generator": "message_type"},
    "read": {"type": "boolean", "x-generator": "boolean"},
    "created_at": {"type": "string", "format": "date-time", "x-generator": "past_date"},
    "read_at": {"type": "string", "format": "date-time", "x-generator": "past_date"}
  }
}

