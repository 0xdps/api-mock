{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Subscription",
  "type": "object",
  "x-resource": {"name": "subscriptions", "singular": "subscription"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "user_id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 1000}},
    "plan": {"type": "string", "x-generator": "subscription_plan"},
    "status": {"type": "string", "x-generator": "subscription_status"},
    "price": {"type": "number", "x-generator": "price"},
    "currency": {"type": "string", "x-generator": "currency"},
    "billing_cycle": {"type": "string", "x-generator": "billing_cycle"},
    "start_date": {"type": "string", "format": "date", "x-generator": "past_date"},
    "end_date": {"type": "string", "format": "date", "x-generator": "future_date"},
    "next_billing_date": {"type": "string", "format": "date", "x-generator": "future_date"},
    "auto_renew": {"type": "boolean", "x-generator": "boolean"},
    "trial_ends_at": {"type": "string", "format": "date", "x-generator": "future_date"}
  }
}

