{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Album",
  "type": "object",
  "x-resource": {"name": "albums", "singular": "album", "group": "media"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "title": {"type": "string", "x-generator": "album_title"},
    "artist": {"type": "string", "x-generator": "name"},
    "genre": {"type": "string", "x-generator": "music_genre"},
    "release_date": {"type": "string", "format": "date", "x-generator": "past_date"},
    "label": {"type": "string", "x-generator": "company"},
    "tracks": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 8, "max": 20}},
    "duration": {"type": "integer", "description": "Duration in seconds", "x-generator": "album_duration"},
    "rating": {"type": "number", "x-generator": "rating"},
    "price": {"type": "number", "x-generator": "price"},
    "currency": {"type": "string", "x-generator": "currency"},
    "cover": {"type": "string", "format": "uri", "x-generator": "image_url"}
  }
}

