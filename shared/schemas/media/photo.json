{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Photo",
  "type": "object",
  "x-resource": {"name": "photos", "singular": "photo", "group": "media"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 100000}},
    "title": {"type": "string", "x-generator": "sentence"},
    "photographer": {"type": "string", "x-generator": "name"},
    "url": {"type": "string", "format": "uri", "x-generator": "image_url"},
    "width": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 800, "max": 4000}},
    "height": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 600, "max": 3000}},
    "tags": {"type": "array", "items": {"type": "string"}, "x-generator": "tags"},
    "likes": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 0, "max": 10000}},
    "uploaded_at": {"type": "string", "format": "date-time", "x-generator": "past_date"}
  }
}
