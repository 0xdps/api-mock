{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Match",
  "type": "object",
  "x-resource": {"name": "matches", "singular": "match"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "home_team": {"type": "string", "x-generator": "team_name"},
    "away_team": {"type": "string", "x-generator": "team_name"},
    "home_score": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 0, "max": 10}},
    "away_score": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 0, "max": 10}},
    "sport": {"type": "string", "x-generator": "sport"},
    "league": {"type": "string", "x-generator": "league"},
    "stadium": {"type": "string", "x-generator": "stadium"},
    "city": {"type": "string", "x-generator": "city"},
    "status": {"type": "string", "x-generator": "match_status"},
    "match_date": {"type": "string", "format": "date-time", "x-generator": "future_date"},
    "attendance": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1000, "max": 100000}}
  }
}

