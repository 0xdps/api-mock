{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Flight",
  "type": "object",
  "x-resource": {"name": "flights", "singular": "flight", "group": "travel"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "flight_number": {"type": "string", "x-generator": "flight_number"},
    "airline": {"type": "string", "x-generator": "airline"},
    "origin": {"type": "string", "x-generator": "city"},
    "origin_code": {"type": "string", "x-generator": "airport_code"},
    "destination": {"type": "string", "x-generator": "city"},
    "destination_code": {"type": "string", "x-generator": "airport_code"},
    "departure_time": {"type": "string", "format": "date-time", "x-generator": "future_date"},
    "arrival_time": {"type": "string", "format": "date-time", "x-generator": "future_date"},
    "duration": {"type": "integer", "description": "Duration in minutes", "x-generator": "flight_duration"},
    "aircraft": {"type": "string", "x-generator": "aircraft"},
    "price": {"type": "number", "x-generator": "flight_price"},
    "currency": {"type": "string", "x-generator": "currency"},
    "available_seats": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 0, "max": 300}},
    "class": {"type": "string", "x-generator": "flight_class"},
    "status": {"type": "string", "x-generator": "flight_status"}
  }
}

