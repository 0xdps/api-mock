{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "News",
  "type": "object",
  "x-resource": {"name": "news", "singular": "news_article"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "headline": {"type": "string", "x-generator": "sentence"},
    "summary": {"type": "string", "x-generator": "paragraph"},
    "content": {"type": "string", "x-generator": "paragraph"},
    "author": {"type": "string", "x-generator": "name"},
    "source": {"type": "string", "x-generator": "company"},
    "category": {"type": "string", "x-generator": "news_category"},
    "country": {"type": "string", "x-generator": "country"},
    "language": {"type": "string", "x-generator": "language"},
    "tags": {"type": "array", "x-generator": "tags"},
    "image": {"type": "string", "format": "uri", "x-generator": "image_url"},
    "url": {"type": "string", "format": "uri", "x-generator": "url"},
    "published_at": {"type": "string", "format": "date-time", "x-generator": "past_date"}
  }
}

