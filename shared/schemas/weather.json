{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Weather",
  "type": "object",
  "description": "Weather data for locations",
  "x-resource": {
    "name": "weather",
    "singular": "weather",
    "description": "Current weather conditions and forecasts"
  },
  "properties": {
    "id": {
      "type": "integer",
      "description": "Weather record ID",
      "x-generator": "random_int",
      "x-generator-params": {
        "min": 1,
        "max": 10000
      }
    },
    "city": {
      "type": "string",
      "description": "City name",
      "x-generator": "city"
    },
    "country": {
      "type": "string",
      "description": "Country name",
      "x-generator": "country"
    },
    "latitude": {
      "type": "number",
      "description": "Latitude",
      "x-generator": "latitude"
    },
    "longitude": {
      "type": "number",
      "description": "Longitude",
      "x-generator": "longitude"
    },
    "temperature": {
      "type": "number",
      "description": "Temperature in Celsius",
      "x-generator": "temperature"
    },
    "feels_like": {
      "type": "number",
      "description": "Feels like temperature",
      "x-generator": "temperature"
    },
    "humidity": {
      "type": "integer",
      "description": "Humidity percentage",
      "x-generator": "humidity"
    },
    "pressure": {
      "type": "integer",
      "description": "Atmospheric pressure in hPa",
      "x-generator": "pressure"
    },
    "wind_speed": {
      "type": "number",
      "description": "Wind speed in m/s",
      "x-generator": "wind_speed"
    },
    "wind_direction": {
      "type": "string",
      "description": "Wind direction",
      "x-generator": "wind_direction"
    },
    "condition": {
      "type": "string",
      "description": "Weather condition",
      "x-generator": "weather_condition"
    },
    "description": {
      "type": "string",
      "description": "Detailed description",
      "x-generator": "weather_description"
    },
    "visibility": {
      "type": "integer",
      "description": "Visibility in meters",
      "x-generator": "visibility"
    },
    "uv_index": {
      "type": "integer",
      "description": "UV index",
      "x-generator": "uv_index"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Observation time",
      "x-generator": "date_time"
    }
  },
  "required": ["id", "city", "country", "temperature"]
}

