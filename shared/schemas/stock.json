{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stock",
  "type": "object",
  "x-resource": {"name": "stocks", "singular": "stock"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "symbol": {"type": "string", "x-generator": "stock_symbol"},
    "name": {"type": "string", "x-generator": "company"},
    "exchange": {"type": "string", "x-generator": "stock_exchange"},
    "price": {"type": "number", "x-generator": "stock_price"},
    "change": {"type": "number", "x-generator": "stock_change"},
    "change_percent": {"type": "number", "x-generator": "stock_change_percent"},
    "volume": {"type": "integer", "x-generator": "stock_volume"},
    "market_cap": {"type": "number", "x-generator": "market_cap"},
    "high": {"type": "number", "x-generator": "stock_price"},
    "low": {"type": "number", "x-generator": "stock_price"},
    "open": {"type": "number", "x-generator": "stock_price"},
    "previous_close": {"type": "number", "x-generator": "stock_price"},
    "currency": {"type": "string", "x-generator": "currency"},
    "timestamp": {"type": "string", "format": "date-time", "x-generator": "date_time"}
  }
}

