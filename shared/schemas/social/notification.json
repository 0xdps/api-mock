{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Notification",
  "type": "object",
  "x-resource": {"name": "notifications", "singular": "notification", "group": "social"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "user_id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 1000}},
    "title": {"type": "string", "x-generator": "sentence"},
    "message": {"type": "string", "x-generator": "sentence"},
    "type": {"type": "string", "x-generator": "notification_type"},
    "priority": {"type": "string", "x-generator": "priority"},
    "read": {"type": "boolean", "x-generator": "boolean"},
    "action_url": {"type": "string", "format": "uri", "x-generator": "url"},
    "created_at": {"type": "string", "format": "date-time", "x-generator": "past_date"},
    "read_at": {"type": "string", "format": "date-time", "x-generator": "past_date"}
  }
}

