{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Review",
  "type": "object",
  "description": "Customer product review with rating, title, body text, verified purchase status, helpful votes, and creation date. Used for e-commerce platforms, review systems, and product feedback management.",
  "x-resource": {
    "name": "reviews",
    "singular": "review",
    "description": "Customer product reviews",
    "group": "social",
    "routes": {
      "path": "/reviews",
      "methods": ["GET", "POST", "PUT", "DELETE"],
      "aliases": ["/product-reviews", "/v2/reviews"]
    }
  },
  "properties": {
    "id": {
      "type": "integer",
      "description": "Unique identifier for the review",
      "x-generator": "random_int",
      "x-generator-params": {
        "min": 1,
        "max": 10000
      }
    },
    "product_id": {
      "type": "integer",
      "description": "Foreign key reference to the product being reviewed",
      "x-generator": "random_int",
      "x-generator-params": {
        "min": 1,
        "max": 1000
      }
    },
    "user_id": {
      "type": "integer",
      "description": "Foreign key reference to the user who wrote the review",
      "x-generator": "random_int",
      "x-generator-params": {
        "min": 1,
        "max": 100
      }
    },
    "rating": {
      "type": "integer",
      "description": "Rating from 1 to 5 stars",
      "x-generator": "random_int",
      "x-generator-params": {
        "min": 1,
        "max": 5
      }
    },
    "title": {
      "type": "string",
      "description": "Title or headline of the review",
      "x-generator": "sentence"
    },
    "body": {
      "type": "string",
      "description": "Detailed review content or body text",
      "x-generator": "paragraph"
    },
    "verified_purchase": {
      "type": "boolean",
      "description": "Whether the reviewer is a verified purchaser of the product",
      "x-generator": "boolean"
    },
    "helpful_count": {
      "type": "integer",
      "description": "Number of users who found this review helpful",
      "x-generator": "random_int",
      "x-generator-params": {
        "min": 0,
        "max": 500
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the review was posted",
      "x-generator": "past_date"
    }
  },
  "required": ["id", "product_id", "user_id", "rating"]
}
