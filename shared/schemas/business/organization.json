{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Organization",
  "type": "object",
  "x-resource": {"name": "organizations", "singular": "organization", "group": "business"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "name": {"type": "string", "x-generator": "company"},
    "type": {"type": "string", "x-generator": "organization_type"},
    "description": {"type": "string", "x-generator": "paragraph"},
    "website": {"type": "string", "format": "uri", "x-generator": "url"},
    "email": {"type": "string", "format": "email", "x-generator": "email"},
    "phone": {"type": "string", "x-generator": "phone"},
    "address": {"type": "string", "x-generator": "address"},
    "city": {"type": "string", "x-generator": "city"},
    "country": {"type": "string", "x-generator": "country"},
    "employees": {"type": "integer", "x-generator": "employees"},
    "founded": {"type": "integer", "x-generator": "founded_year"},
    "logo": {"type": "string", "format": "uri", "x-generator": "image_url"}
  }
}

