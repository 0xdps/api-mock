{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Invoice",
  "type": "object",
  "x-resource": {"name": "invoices", "singular": "invoice", "group": "business"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "invoice_number": {"type": "string", "x-generator": "invoice_number"},
    "customer_id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 1000}},
    "customer_name": {"type": "string", "x-generator": "name"},
    "customer_email": {"type": "string", "format": "email", "x-generator": "email"},
    "amount": {"type": "number", "x-generator": "price"},
    "tax": {"type": "number", "x-generator": "tax"},
    "total": {"type": "number", "x-generator": "price"},
    "currency": {"type": "string", "x-generator": "currency"},
    "status": {"type": "string", "x-generator": "invoice_status"},
    "issue_date": {"type": "string", "format": "date", "x-generator": "past_date"},
    "due_date": {"type": "string", "format": "date", "x-generator": "future_date"},
    "paid_at": {"type": "string", "format": "date-time", "x-generator": "past_date"}
  }
}

