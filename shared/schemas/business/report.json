{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Report",
  "type": "object",
  "x-resource": {"name": "reports", "singular": "report", "group": "business"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "title": {"type": "string", "x-generator": "sentence"},
    "type": {"type": "string", "x-generator": "word"},
    "description": {"type": "string", "x-generator": "paragraph"},
    "created_by": {"type": "string", "x-generator": "name"},
    "department": {"type": "string", "x-generator": "department"},
    "period_start": {"type": "string", "format": "date", "x-generator": "past_date"},
    "period_end": {"type": "string", "format": "date", "x-generator": "past_date"},
    "status": {"type": "string", "x-generator": "status"},
    "file_url": {"type": "string", "format": "uri", "x-generator": "url"},
    "created_at": {"type": "string", "format": "date-time", "x-generator": "past_date"}
  }
}

