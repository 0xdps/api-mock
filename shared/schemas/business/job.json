{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Job",
  "type": "object",
  "description": "Job postings",
  "x-resource": {
    "name": "jobs",
    "singular": "job",
    "description": "Job listings and opportunities",
    "group": "business"
  },
  "properties": {
    "id": {
      "type": "integer",
      "x-generator": "random_int",
      "x-generator-params": {"min": 1, "max": 10000}
    },
    "title": {
      "type": "string",
      "x-generator": "job"
    },
    "company": {
      "type": "string",
      "x-generator": "company"
    },
    "description": {
      "type": "string",
      "x-generator": "paragraph"
    },
    "requirements": {
      "type": "string",
      "x-generator": "paragraph"
    },
    "location": {
      "type": "string",
      "x-generator": "city"
    },
    "country": {
      "type": "string",
      "x-generator": "country"
    },
    "type": {
      "type": "string",
      "x-generator": "job_type"
    },
    "level": {
      "type": "string",
      "x-generator": "job_level"
    },
    "salary_min": {
      "type": "integer",
      "x-generator": "salary_min"
    },
    "salary_max": {
      "type": "integer",
      "x-generator": "salary_max"
    },
    "currency": {
      "type": "string",
      "x-generator": "currency"
    },
    "remote": {
      "type": "boolean",
      "x-generator": "boolean"
    },
    "posted_at": {
      "type": "string",
      "format": "date-time",
      "x-generator": "past_date"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "x-generator": "future_date"
    }
  }
}

