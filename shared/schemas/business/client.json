{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Client",
  "type": "object",
  "x-resource": {"name": "clients", "singular": "client", "group": "business"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "name": {"type": "string", "x-generator": "company"},
    "contact_person": {"type": "string", "x-generator": "name"},
    "email": {"type": "string", "format": "email", "x-generator": "email"},
    "phone": {"type": "string", "x-generator": "phone"},
    "address": {"type": "string", "x-generator": "address"},
    "city": {"type": "string", "x-generator": "city"},
    "country": {"type": "string", "x-generator": "country"},
    "industry": {"type": "string", "x-generator": "industry"},
    "status": {"type": "string", "x-generator": "status"},
    "contract_value": {"type": "number", "x-generator": "price"},
    "since": {"type": "string", "format": "date", "x-generator": "past_date"}
  }
}

