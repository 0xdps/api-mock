{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Testimonial",
  "type": "object",
  "x-resource": {"name": "testimonials", "singular": "testimonial"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "name": {"type": "string", "x-generator": "name"},
    "position": {"type": "string", "x-generator": "job"},
    "company": {"type": "string", "x-generator": "company"},
    "message": {"type": "string", "x-generator": "paragraph"},
    "rating": {"type": "number", "x-generator": "rating"},
    "avatar": {"type": "string", "format": "uri", "x-generator": "avatar"},
    "featured": {"type": "boolean", "x-generator": "boolean"},
    "created_at": {"type": "string", "format": "date-time", "x-generator": "past_date"}
  }
}

