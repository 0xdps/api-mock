{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Language",
  "type": "object",
  "description": "World languages",
  "x-resource": {
    "name": "languages",
    "singular": "language",
    "description": "Languages with ISO codes",
    "group": "reference"
  },
  "properties": {
    "id": {
      "type": "integer",
      "description": "Language ID",
      "x-generator": "random_int",
      "x-generator-params": {
        "min": 1,
        "max": 1000
      }
    },
    "name": {
      "type": "string",
      "description": "Language name",
      "x-generator": "language"
    },
    "native_name": {
      "type": "string",
      "description": "Native language name",
      "x-generator": "language_native"
    },
    "code": {
      "type": "string",
      "description": "ISO 639-1 code",
      "x-generator": "language_code"
    },
    "code3": {
      "type": "string",
      "description": "ISO 639-2 code",
      "x-generator": "language_code3"
    },
    "family": {
      "type": "string",
      "description": "Language family",
      "x-generator": "language_family"
    },
    "speakers": {
      "type": "integer",
      "description": "Number of speakers",
      "x-generator": "speakers"
    },
    "countries": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Countries where spoken",
      "x-generator": "language_countries"
    }
  },
  "required": ["id", "name", "code"]
}

