{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ticket",
  "type": "object",
  "x-resource": {"name": "tickets", "singular": "ticket", "group": "productivity"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "ticket_number": {"type": "string", "x-generator": "ticket_number"},
    "subject": {"type": "string", "x-generator": "sentence"},
    "description": {"type": "string", "x-generator": "paragraph"},
    "customer_id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 1000}},
    "customer_name": {"type": "string", "x-generator": "name"},
    "customer_email": {"type": "string", "format": "email", "x-generator": "email"},
    "assigned_to": {"type": "string", "x-generator": "name"},
    "priority": {"type": "string", "x-generator": "priority"},
    "status": {"type": "string", "x-generator": "ticket_status"},
    "category": {"type": "string", "x-generator": "ticket_category"},
    "created_at": {"type": "string", "format": "date-time", "x-generator": "past_date"},
    "updated_at": {"type": "string", "format": "date-time", "x-generator": "past_date"},
    "resolved_at": {"type": "string", "format": "date-time", "x-generator": "past_date"}
  }
}

