{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event",
  "type": "object",
  "description": "Events and conferences",
  "x-resource": {
    "name": "events",
    "singular": "event",
    "description": "Calendar events and conferences",
    "group": "productivity"
  },
  "properties": {
    "id": {
      "type": "integer",
      "x-generator": "random_int",
      "x-generator-params": {"min": 1, "max": 10000}
    },
    "title": {
      "type": "string",
      "x-generator": "event_title"
    },
    "description": {
      "type": "string",
      "x-generator": "paragraph"
    },
    "category": {
      "type": "string",
      "x-generator": "event_category"
    },
    "start_date": {
      "type": "string",
      "format": "date-time",
      "x-generator": "future_date"
    },
    "end_date": {
      "type": "string",
      "format": "date-time",
      "x-generator": "future_date"
    },
    "location": {
      "type": "string",
      "x-generator": "address"
    },
    "city": {
      "type": "string",
      "x-generator": "city"
    },
    "country": {
      "type": "string",
      "x-generator": "country"
    },
    "venue": {
      "type": "string",
      "x-generator": "venue"
    },
    "organizer": {
      "type": "string",
      "x-generator": "company"
    },
    "capacity": {
      "type": "integer",
      "x-generator": "random_int",
      "x-generator-params": {"min": 50, "max": 5000}
    },
    "price": {
      "type": "number",
      "x-generator": "price"
    },
    "currency": {
      "type": "string",
      "x-generator": "currency"
    },
    "is_online": {
      "type": "boolean",
      "x-generator": "boolean"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "x-generator": "url"
    }
  }
}

