{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Course",
  "type": "object",
  "x-resource": {"name": "courses", "singular": "course"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "title": {"type": "string", "x-generator": "course_title"},
    "description": {"type": "string", "x-generator": "paragraph"},
    "instructor": {"type": "string", "x-generator": "name"},
    "category": {"type": "string", "x-generator": "course_category"},
    "level": {"type": "string", "x-generator": "course_level"},
    "duration": {"type": "integer", "description": "Duration in hours", "x-generator": "course_duration"},
    "lessons": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 5, "max": 50}},
    "enrolled": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 0, "max": 10000}},
    "rating": {"type": "number", "x-generator": "rating"},
    "price": {"type": "number", "x-generator": "price"},
    "currency": {"type": "string", "x-generator": "currency"},
    "language": {"type": "string", "x-generator": "language"},
    "certificate": {"type": "boolean", "x-generator": "boolean"},
    "thumbnail": {"type": "string", "format": "uri", "x-generator": "image_url"},
    "created_at": {"type": "string", "format": "date-time", "x-generator": "past_date"}
  }
}

