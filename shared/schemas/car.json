{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Car",
  "type": "object",
  "x-resource": {"name": "cars", "singular": "car"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "make": {"type": "string", "x-generator": "car_make"},
    "model": {"type": "string", "x-generator": "car_model"},
    "year": {"type": "integer", "x-generator": "car_year"},
    "color": {"type": "string", "x-generator": "color"},
    "vin": {"type": "string", "x-generator": "vin"},
    "type": {"type": "string", "x-generator": "car_type"},
    "fuel_type": {"type": "string", "x-generator": "fuel_type"},
    "transmission": {"type": "string", "x-generator": "transmission"},
    "mileage": {"type": "integer", "x-generator": "mileage"},
    "price": {"type": "number", "x-generator": "car_price"},
    "currency": {"type": "string", "x-generator": "currency"},
    "condition": {"type": "string", "x-generator": "condition"},
    "features": {"type": "array", "items": {"type": "string"}, "x-generator": "car_features"},
    "image": {"type": "string", "format": "uri", "x-generator": "image_url"}
  }
}

