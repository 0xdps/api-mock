{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recipe",
  "type": "object",
  "x-resource": {"name": "recipes", "singular": "recipe"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "title": {"type": "string", "x-generator": "recipe_title"},
    "description": {"type": "string", "x-generator": "paragraph"},
    "cuisine": {"type": "string", "x-generator": "cuisine"},
    "category": {"type": "string", "x-generator": "recipe_category"},
    "difficulty": {"type": "string", "x-generator": "difficulty"},
    "prep_time": {"type": "integer", "description": "Minutes", "x-generator": "prep_time"},
    "cook_time": {"type": "integer", "description": "Minutes", "x-generator": "cook_time"},
    "servings": {"type": "integer", "x-generator": "servings"},
    "calories": {"type": "integer", "x-generator": "calories"},
    "rating": {"type": "number", "x-generator": "rating"},
    "author": {"type": "string", "x-generator": "name"},
    "image": {"type": "string", "format": "uri", "x-generator": "image_url"},
    "created_at": {"type": "string", "format": "date-time", "x-generator": "past_date"}
  }
}

