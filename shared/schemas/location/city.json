{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "City",
  "type": "object",
  "description": "City geographic and demographic information including location coordinates, population, timezone, elevation, and administrative details. Used for location services, mapping applications, and geographic data systems.",
  "x-resource": {
    "name": "cities",
    "singular": "city",
    "description": "Cities with geographic data",
    "group": "location"
  },
  "properties": {
    "id": {
      "type": "integer",
      "description": "Unique identifier for the city record",
      "x-generator": "random_int",
      "x-generator-params": {
        "min": 1,
        "max": 50000
      }
    },
    "name": {
      "type": "string",
      "description": "Official name of the city",
      "x-generator": "city"
    },
    "country": {
      "type": "string",
      "description": "Name of the country where the city is located",
      "x-generator": "country"
    },
    "country_code": {
      "type": "string",
      "description": "ISO 3166-1 alpha-2 country code (e.g., US, GB, FR)",
      "x-generator": "country_code"
    },
    "state": {
      "type": "string",
      "description": "State, province, or administrative region where the city is located",
      "x-generator": "state"
    },
    "latitude": {
      "type": "number",
      "description": "Geographic latitude coordinate (decimal degrees, -90 to 90)",
      "x-generator": "latitude"
    },
    "longitude": {
      "type": "number",
      "description": "Geographic longitude coordinate (decimal degrees, -180 to 180)",
      "x-generator": "longitude"
    },
    "population": {
      "type": "integer",
      "description": "Total population of the city",
      "x-generator": "city_population"
    },
    "timezone": {
      "type": "string",
      "description": "IANA timezone identifier (e.g., America/New_York, Europe/London)",
      "x-generator": "timezone"
    },
    "elevation": {
      "type": "integer",
      "description": "Elevation above sea level in meters",
      "x-generator": "elevation"
    }
  },
  "required": ["id", "name", "country"]
}

