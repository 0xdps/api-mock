{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Player",
  "type": "object",
  "x-resource": {"name": "players", "singular": "player", "group": "people"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "name": {"type": "string", "x-generator": "name"},
    "jersey_number": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 99}},
    "position": {"type": "string", "x-generator": "position"},
    "team_id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 1000}},
    "team_name": {"type": "string", "x-generator": "team_name"},
    "age": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 18, "max": 40}},
    "height": {"type": "number", "description": "Height in cm", "x-generator": "height"},
    "weight": {"type": "number", "description": "Weight in kg", "x-generator": "weight"},
    "nationality": {"type": "string", "x-generator": "country"},
    "goals": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 0, "max": 100}},
    "assists": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 0, "max": 50}},
    "photo": {"type": "string", "format": "uri", "x-generator": "avatar"}
  }
}

