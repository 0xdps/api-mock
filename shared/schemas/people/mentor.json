{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mentor",
  "type": "object",
  "x-resource": {"name": "mentors", "singular": "mentor", "group": "people"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "name": {"type": "string", "x-generator": "name"},
    "email": {"type": "string", "format": "email", "x-generator": "email"},
    "bio": {"type": "string", "x-generator": "paragraph"},
    "photo": {"type": "string", "format": "uri", "x-generator": "avatar"},
    "specialization": {"type": "array", "items": {"type": "string"}, "x-generator": "tags"},
    "experience_years": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 5, "max": 30}},
    "mentees_count": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 0, "max": 50}},
    "rating": {"type": "number", "x-generator": "float", "x-generator-params": {"min": 1, "max": 5}},
    "hourly_rate": {"type": "number", "x-generator": "price"},
    "availability": {"type": "string", "x-generator": "word"}
  }
}

