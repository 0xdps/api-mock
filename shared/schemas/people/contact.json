{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Contact",
  "type": "object",
  "x-resource": {"name": "contacts", "singular": "contact", "group": "people"},
  "properties": {
    "id": {"type": "integer", "x-generator": "random_int", "x-generator-params": {"min": 1, "max": 10000}},
    "first_name": {"type": "string", "x-generator": "first_name"},
    "last_name": {"type": "string", "x-generator": "last_name"},
    "email": {"type": "string", "format": "email", "x-generator": "email"},
    "phone": {"type": "string", "x-generator": "phone"},
    "company": {"type": "string", "x-generator": "company"},
    "job_title": {"type": "string", "x-generator": "job"},
    "address": {"type": "string", "x-generator": "address"},
    "city": {"type": "string", "x-generator": "city"},
    "country": {"type": "string", "x-generator": "country"},
    "notes": {"type": "string", "x-generator": "sentence"},
    "tags": {"type": "array", "items": {"type": "string"}, "x-generator": "tags"},
    "created_at": {"type": "string", "format": "date-time", "x-generator": "past_date"}
  }
}

